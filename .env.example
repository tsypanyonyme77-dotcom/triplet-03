# Root environment for docker-compose.yml (triplet-wide runtime values).
# Copy to .env and replace every placeholder before non-local use.

# --- Partner service addresses inside the compose network ---
TWIN_URL=http://twin:8001
BRAIN_URL=http://brain:8002
GUARDIAN_URL=http://guardian:8003

# --- Optional partner bearer tokens (only if a partner adapter requires them) ---
TWIN_TOKEN=change-me
BRAIN_TOKEN=change-me
GUARDIAN_TOKEN=change-me

# --- Shared signing and auth keys across layers ---
TWIN_HMAC_SECRET=change-me-twin-hmac-secret
BRAIN_HMAC_SECRET=change-me-brain-hmac-secret
GUARDIAN_HMAC_KEY=change-me-guardian-hmac-key
BRAIN_API_KEY=change-me-brain-api-key
TWIN_API_KEY=change-me-twin-api-key
OPS_API_KEY=change-me-ops-api-key

# --- Twin door keys (accepted by Twin endpoints) ---
TWIN_BRAIN_API_KEY=change-me-twin-brain-api-key
TWIN_GUARDIAN_API_KEY=change-me-twin-guardian-api-key
TWIN_OPERATOR_KEY=change-me-twin-operator-key

# --- Brain backing services ---
NEO4J_PASSWORD=change-me-neo4j-password
