# Partner addresses and credentials. Copy to .env (git-ignored). Nothing here is hard-coded in source.
TWIN_URL=http://twin:8001
BRAIN_URL=http://brain:8002
GUARDIAN_URL=http://guardian:8003

# Shared secrets used to authenticate calls between layers (see each INTERFACE.md).
TWIN_TOKEN=change-me
BRAIN_TOKEN=change-me
GUARDIAN_TOKEN=change-me

# City Brain: the secrets it signs and verifies with (HMAC-SHA256; agree them with the Twin and Guardian teams) and the password of its Neo4j.
TWIN_HMAC_SECRET=dev-only-twin-secret
BRAIN_HMAC_SECRET=dev-only-brain-secret
GUARDIAN_HMAC_KEY=dev-only-guardian-key
BRAIN_API_KEY=dev-only-brain-api-key
NEO4J_PASSWORD=citybrain-local-pw
