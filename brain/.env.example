# Brain local environment.
# Copy to brain/.env and replace placeholders. Never commit real secrets.

# --- Shared signing and auth keys ---
TWIN_HMAC_SECRET=change-me-twin-hmac-secret
BRAIN_HMAC_SECRET=change-me-brain-hmac-secret
GUARDIAN_HMAC_KEY=change-me-guardian-hmac-key
BRAIN_API_KEY=change-me-brain-api-key
TWIN_API_KEY=change-me-twin-api-key
OPS_API_KEY=change-me-ops-api-key

# Only needed with --llm: provider key from config/models.yaml (Groq by default).
GROQ_API_KEY=

# Neo4j, the city graph (graph.backend: neo4j, default in compose).
NEO4J_PASSWORD=change-me-neo4j-password

# Optional: where embedding models are cached (default ~/.cache/city-brain/fastembed)
FASTEMBED_CACHE_PATH=
