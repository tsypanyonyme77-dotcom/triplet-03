# Shared secrets (HMAC-SHA256). Agree real values with the partner teams; never commit them.
TWIN_HMAC_SECRET=
BRAIN_HMAC_SECRET=
# Only needed with --llm: the key for the provider named in config/models.yaml (Groq by default).
GROQ_API_KEY=your-groq-api-key-here

# Neo4j, the city graph (graph.backend: neo4j, the default). Blank in Compose: citybrain-local-pw
NEO4J_PASSWORD=


# Where the embedding model is kept after its one download (default ~/.cache/city-brain/fastembed)
FASTEMBED_CACHE_PATH=
