# Copy to .env to change anything; `docker compose up --build` works without it. .env is git-ignored.

# ---- Where the other layers are. Unset: the mocks in this compose file. ----
# A partner on this machine is host.docker.internal, e.g. http://host.docker.internal:9000
# GUARDIAN_URL=http://mock-guardian:8000     # base address; its GET /events feeds the timeline
# BRAIN_URL=http://mock-brain:8000           # base address; its GET /events feeds the timeline
# GUARDIAN_INGEST_URL=                       # where readings go (default: GUARDIAN_URL/ingest)
# BRAIN_NOTIFY_URL=                          # where "new readings" pings go (default: BRAIN_URL/notify)

# ---- Secrets. Change all of them for anything beyond a local demo. ----
TWIN_HMAC_KEY=dev-only-hmac-key
TWIN_BRAIN_API_KEY=dev-only-brain-key
TWIN_GUARDIAN_API_KEY=dev-only-guardian-key
TWIN_OPERATOR_KEY=dev-only-operator-key

# ---- The city. ----
TWIN_SCENARIO=city                 # city | ped-hit | car-crash | building-fire
TWIN_CARS=20                       # 0 to 47
TWIN_PEDESTRIANS=40                # 0 to 100
TWIN_CAR_CRASH_RISK=0.1            # 0 to 1, per car: runs red lights
TWIN_PED_HIT_RISK=0.1              # 0 to 1, per car: does not yield; per pedestrian: ignores signals
TWIN_FIRE_RISK=0                   # 0 to 1, per building: catches fire once, in the first few minutes
TWIN_FLOOD_RISK=0                  # 0 to 1, per street: its drain blocks and a downpour floods it, once
TWIN_DECISION=student              # student | random: how pedestrians and cars choose where to go next
TWIN_SEED=                         # set for a repeatable city
TWIN_EMIT_INTERVAL_S=1

# ---- Host ports. ----
VIEWER_PORT=8080
TWIN_PORT=8000
MOCK_GUARDIAN_PORT=8001
MOCK_BRAIN_PORT=8002
