# Guardian local environment.
# Copy to guardian/.env and replace every value. Never commit real secrets.

# --- Shared signing and auth keys ---
# Guardian accepts either TWIN_HMAC_KEY or TWIN_HMAC_SECRET for Twin signatures.
TWIN_HMAC_KEY=change-me-twin-hmac-secret
GUARDIAN_HMAC_KEY=change-me-guardian-hmac-key
BRAIN_API_KEY=change-me-brain-api-key
TWIN_API_KEY=change-me-twin-api-key
OPS_API_KEY=change-me-ops-api-key

# Optional overrides of config/guardian.yaml
# TWIN_BASE_URL=http://localhost:8101
# TWIN_TRANSPORT=rest
# TWIN_MODE=push
# LOG_DIR=../logs
# GUARDIAN_DB_PATH=./data/guardian.db
# Twin mock physics speed-up (mock only; does not touch timestamps). 1 = real time.
# Raise it to make the physics-heavy live scenario (T11, a real flood rising over minutes) finish in seconds.
# TWIN_SPEED=8
# Optional: the key the Twin requires on its POST /tools/{action} (the Twin's TWIN_TOOLS_API_KEY), sent as X-API-Key.
# TWIN_TOOLS_API_KEY=change-me-twin-tools-key
